          "task_key": "00_setup"
        }
      ],
      "notebook_task": {
        "notebook_path": "/SINASC Project/01_01_import_to_landingzone",
        "source": "WORKSPACE",
        "base_parameters": {
          "pasta": "1996_/Dados/DNRES",
          "ufs": "SP,BR",
          "anos": "todos",
          "executar": "sim"
        }
      }
    },
    {
      "task_key": "01_download_preliminares",
      "depends_on": [
        {
          "task_key": "01_download_definitivos"
        }
      ],
      "notebook_task": {
        "notebook_path": "/SINASC Project/01_01_import_to_landingzone",
        "source": "WORKSPACE",
        "base_parameters": {
          "pasta": "PRELIM/DNRES",
          "ufs": "SP",
          "anos": "todos",
          "executar": "sim"
        }
      }
    },
    {
      "task_key": "01_descompactar",
