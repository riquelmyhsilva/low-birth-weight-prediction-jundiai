      ],
      "notebook_task": {
        "notebook_path": "/SINASC Project/03_load_silver",
        "source": "WORKSPACE",
        "base_parameters": {
          "modo": "incremental",
          "arquivos": ""
        }
      }
    },
    {
      "task_key": "06_gold_ml",
      "depends_on": [
        {
          "task_key": "03_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "/SINASC Project/06_load_gold_ml",
        "source": "WORKSPACE",
        "base_parameters": {
          "forcar": "nao"
        }
      }
    }
  ]
